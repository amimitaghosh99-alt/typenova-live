# ── TypeNova Environment Variables ──────────────────────────────
# Copy this file to `.env` and fill in your values.

# Supabase (required for auth, friends, leaderboard, ranked matchmaking)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Socket.io multiplayer server (races, chat, WebRTC signaling)
# ────────────────────────────────────────────────────────────────
# If unset, the app falls back to:
#   - localhost:3001 during local dev
#   - <your-host>:3001 when deployed (same-origin inference)
# Set this to your publicly-hosted typenova-server URL for production.
VITE_SOCKET_URL=https://your-socket-server.example.com

# Optional: separate URLs for dev vs prod (used only if VITE_SOCKET_URL is empty)
# VITE_SOCKET_DEV_URL=http://localhost:3001
# VITE_SOCKET_PROD_URL=https://your-socket-server.example.com