# ─── TypeNova Environment Configuration Template ─────────────────────────
# Copy this file to .env and provide your credentials:
#   cp .env.example .env

# Supabase (Auth, Leaderboards, Realtime Subscriptions)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Optional: Dedicated AI Provider Keys (Can also be set in-app via BYOK vault)
# VITE_GROQ_API_KEY=
# VITE_OPENROUTER_API_KEY=
# VITE_GEMINI_API_KEY=

# Razorpay Integration (Public Key ID)
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id